# From https://my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# log = only record what would happen (start here); act = report + block + delete
TG_MODE=log

# Score needed to call a message spam (see README for the scoring table)
TG_THRESHOLD=3

# Comma-separated extra words/phrases that count as spam keywords
TG_EXTRA_KEYWORDS=

# Where the session, log and whitelist live (default: next to spamguard.py)
TG_DATA_DIR=
